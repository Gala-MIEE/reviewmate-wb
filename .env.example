# ===== Wildberries =====
# 1 = демо-режим (тестовые данные, на WB ничего не уходит). Для работы поставьте 0 и вставьте токен.
DEMO_MODE=1
# Токен из кабинета продавца: Профиль → Настройки → Доступ к API. Категории: «Вопросы и отзывы» (чтение и запись), «Контент» (только чтение).
WB_API_TOKEN=
# Обрабатывать только товары этого бренда (пусто = все бренды кабинета)
BRAND_FILTER=Paperform

# ===== Ozon (необязательно; пусто = площадка не опрашивается) =====
# Кабинет продавца → Настройки → API-ключи. Нужен ключ Seller API и доступ к отзывам и вопросам.
OZON_CLIENT_ID=
OZON_API_KEY=

# ===== Яндекс Маркет (необязательно) =====
# Токен с доступом «Общение с покупателями». businessId — номер кабинета, его видно в GET /v2/campaigns.
YM_API_KEY=
YM_BUSINESS_ID=

# ===== Нейросеть (необязательно; без неё ответы собираются из шаблонов kb/templates.csv) =====
# Любой OpenAI-совместимый API. Примеры:
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=<модель из вашего аккаунта>
#   YandexGPT:  LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1   LLM_MODEL=gpt://<folder_id>/yandexgpt/latest
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ===== Доступ к интерфейсу =====
ADMIN_USER=manager
ADMIN_PASSWORD=придумайте-пароль
SECRET_KEY=длинная-случайная-строка

# ===== Уведомления о вопросах и критичных отзывах в Telegram (необязательно) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
